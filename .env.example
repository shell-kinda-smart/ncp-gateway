# Server Configuration
PORT=8080
TESTNET=true

# Database Connection (PostgreSQL)
# Format: postgres://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gateway_db?sslmode=disable

# Bitcoin Node RPC
# Public Free Nodes (Example: GetBlock or NOWNodes)
# Sign up at getblock.io to get your API Key
BTC_RPC_URL=https://go.getblock.io/YOUR_API_KEY_HERE
BTC_RPC_USER=
BTC_RPC_PASS=

# Litecoin Node RPC
LTC_RPC_URL=https://go.getblock.io/YOUR_LTC_API_KEY_HERE
LTC_RPC_USER=
LTC_RPC_PASS=
